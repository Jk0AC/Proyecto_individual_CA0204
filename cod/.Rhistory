#Flujos:
P <- 1000
cf <- 200 + 10 * d
sum(cf) > P #Tiene TIR única
f <- function(i){
sum(cf*1/(1+i)^(1:length(cf))) - P
}
# Calculamos TIR con:
# uniroot():
tir.uni <- uniroot(f, c(0,1))
iter.uni <- tir.uni[[3]]
#Tolerancia uniroot:
.Machine$double.eps^0.25 # 0.0001220703
#bisect() y newtonRaphson():
tir.bis <- bisect(f, 0, 1, maxiter = 27)
iter.bis <- tir.bis[[3]]
# Note que en b) calculamos el error entre la aproximación real de la TIR y mn
# usando bisección. Para verifiacar esto podemos calcular la TIR real con la IRR de
# Financial Math que aproxima bastante bien el real y el que nos da con el
# método de bisección iterando 27 veces:
abs(tir.bis[[1]] - tir.irr)
# Note que en b) calculamos el error entre la aproximación real de la TIR y mn
# usando bisección. Para verifiacar esto podemos calcular la TIR real con la IRR de
# Financial Math que aproxima bastante bien el real y el que nos da con el
# método de bisección iterando 27 veces:
tir.bis[[4]]
# Mis datos:
semilla <-  37241
d <- c(3, 7, 2, 4, 1)
#Flujos:
P <- 1000
cf <- 200 + 10 * d
sum(cf) > P #Tiene TIR única
f <- function(i){
sum(cf*1/(1+i)^(1:length(cf))) - P
}
# Calculamos TIR con:
# uniroot():
tir.uni <- uniroot(f, c(0,1))
iter.uni <- tir.uni[[3]]
#Tolerancia uniroot:
.Machine$double.eps^0.25 # 0.0001220703
#bisect() y newtonRaphson():
tir.bis <- bisect(f, 0, 1, maxiter = 27)
iter.bis <- tir.bis[[3]]
#Error método:
tir.bis[[4]]
# Note que el error es ligeramente mayor que en que predijimos en b)
# este puede por la forma interna que funciona bisect()
tir.nr <- newtonRaphson(f, 0)
iter.nr <- tir.nr[[3]]
#IRR Financial Math:
tir.irr <- IRR(cf0 = P, cf = cf, times = 1:5)
tir.bis[[4]]
