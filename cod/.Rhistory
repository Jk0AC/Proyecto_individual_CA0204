tir.bis[[1]],
tir.nr[[1]],
tir.irr
),
Iteraciones = c(iter.uni,
iter.bis,
iter.nr,
NA
),
f_TIR = c(f(tir.uni[[1]]),
f(tir.bis[[1]]),
f(tir.nr[[1]]),
f(tir.irr)
)
)
