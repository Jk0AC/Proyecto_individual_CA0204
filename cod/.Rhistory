# b)
marcar_atipicos <- function(x, metodo = "tukey"){
if(!(metodo %in% c("tukey","hampel"))){
stop("Formato no aceptado, metodo debe ser tukey o hampel")
}
if(!is.numeric(x)){
stop("Formato no aceptado, x debe ser un vector númerico")
}
if(metodo == "tukey"){
#Cuantiles del vector de la columna:
q1 = quantile(x, 0.25, na.rm = TRUE)
q3 = quantile(x, 0.75, na.rm = TRUE)
iqr = IQR(x, na.rm = TRUE)
#Establecemos limites (fuera de estos valor se considera outlier):
lim.inf = q1 - 1.5 * iqr
lim.sup = q3 + 1.5 * iqr
#Evaluamos si el vector tiene un valor que se pase de los limites.
#Y las marcamos en un vector logico.
flag = x < lim.inf | x > lim.sup
#Si el vector tiene NA no seran considerados outliers:
flag[is.na(flag)] = FALSE
return(flag)
}
if(metodo == "hampel"){
MAD = 1.4826*median(abs(x-median(x, na.rm = TRUE)), na.rm = TRUE)
#Establecemos limites (fuera de estos valor se considera outlier):
lim.inf = median(x, na.rm = TRUE) - 3*MAD
lim.sup = median(x, na.rm = TRUE) + 3*MAD
#Evaluamos si el vector tiene un valor que se pase de los limites.
#Y las marcamos en un vector logico:
flag = x < lim.inf | x > lim.sup
#Si el vector tiene NA no seran considerados outliers:
flag[is.na(flag)] = FALSE
return(flag)
}
}
?IQR()
